# Required in production — generate with: openssl rand -base64 48
SESSION_SECRET=

# SMTP for outbound email (optional — emails queue in the outbox and are
# marked 'skipped' when unset; in-app notifications always deliver)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hr@yourcompany.com

# Set to 1 when an external cron drives POST /api/admin/jobs instead of the
# in-process hourly timer
DISABLE_JOB_TIMER=0
