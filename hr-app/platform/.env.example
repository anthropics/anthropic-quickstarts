# Copy to .env and fill in real values. See docs/adr/0001-stack-decisions.md
# for what each of these backs.

# --- Database (platform + tenant schemas share one Postgres instance) ---
DATABASE_URL=postgresql://hrcore:hrcore_dev@localhost:5432/hrcore

# --- Redis (BullMQ job queues, caching) ---
REDIS_URL=redis://localhost:6379

# --- Clerk (auth) — get real keys from https://dashboard.clerk.com ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- S3-compatible object storage ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Search: "postgres" (default, no external dependency) or "meilisearch" ---
SEARCH_PROVIDER=postgres
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=hrcore_dev_master_key

# --- Email / SMS ---
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- AI (Anthropic Claude API) ---
ANTHROPIC_API_KEY=

# --- E-signature ---
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=

API_PORT=4000
NODE_ENV=development
